target Python

import FrostFmuReactor from "../../../src/lib/simulation/FrostFmuReactor.lf"

preamble{=
    from fmu_test_tools import log_line, describe_changes, describe_trigger

    FOLDERS = {"input": "inputs", "output": "outputs", "local": "locals"}
=}

# A FrostFmuReactor whose data model follows the FMU names:
# Machine/{inputs,outputs,parameters,locals}/<variable>. This naming is a
# convention of the test data models, which is why the binding lives here and
# not in the library.
#
# - A write on an input node (from any Frost node) updates fmu_inputs and
#   applies it at its tag.
# - Every commit writes each scalar output, parameter and local that has a
#   node (arrays are not published), so the data model always shows the FMU
#   state at the committed tag.
# - mirror_all=True makes the test fail when a scalar FMU variable has no node.
#
# Subclasses check each published snapshot in _on_commit(snapshot) and read
# self.published / self.triggers at shutdown.
reactor FmuNode(mirror_all = False) extends FrostFmuReactor{
    state node_folders
    state missing_nodes
    state published = {=[]=}
    state triggers = {=[]=}
    state writes = {=[]=}

    method _ms(){=
        return lf.time.logical_elapsed() // 1000000
    =}

    method _log(kind, text){=
        self.logger.info(log_line(lf.time.logical_elapsed(), kind, text))
    =}

    method _node(folder, name){=
        node = self.data_model.get_node(f"Machine/{folder}/{name}")
        assert node is not None, f"the data model has no Machine/{folder}/{name}"
        return node
    =}

    method _folder(name){=
        '''Return the data model folder of an FMU variable, from its causality.'''
        return FOLDERS.get(self.fmu_dictionary[name].causality, "parameters")
    =}

    method _published_folders(){=
        '''Return FMU variable -> data model folder for every published variable.

        Worked out at the first commit.
        '''
        if self.node_folders is not None:
            return self.node_folders
        self.node_folders, self.missing_nodes = {}, []
        for name, variable in self.fmu_dictionary.items():
            if variable.causality in ("input", "independent") or variable.shape:
                continue
            if self.data_model.get_node(f"Machine/{self._folder(name)}/{name}") is None:
                self.missing_nodes.append(name)
            else:
                self.node_folders[name] = self._folder(name)
        self.missing_nodes += [
            name
            for name in self.fmu_inputs
            if self.data_model.get_node(f"Machine/inputs/{name}") is None
        ]

        self._log("PUBLISH", f"published on the data model: {list(self.node_folders)}")
        if self.missing_nodes:
            shown = ", ".join(self.missing_nodes[:5])
            if len(self.missing_nodes) > 5:
                shown += ", ..."
            self._log("PUBLISH", f"{len(self.missing_nodes)} scalar FMU variables have no node: {shown}")
        if self.mirror_all:
            assert not self.missing_nodes, f"mirror_all: no node for {self.missing_nodes}"
        return self.node_folders
    =}

    method _on_commit(snapshot){=
        '''Subclass hook: check the snapshot that was just published.'''
        pass
    =}

    // @override
    method _commit(){=
        now = lf.time.logical_elapsed()
        assert self.fmu_ns == now, f"commit with the FMU at {self.fmu_ns} ns but LF at {now} ns"

        snapshot = {}
        for name, folder in self._published_folders().items():
            value = self.model.read(self.fmu_dictionary[name])
            node = self._node(folder, name)
            node.write(value)
            snapshot[f"{folder}/{name}"] = node.read()
            assert snapshot[f"{folder}/{name}"] == value, (
                f"node {folder}/{name} holds {snapshot[f'{folder}/{name}']}, "
                f"the FMU {value}"
            )

        previous = self.published[-1][1] if self.published else None
        self._log("COMMIT", describe_changes(previous, snapshot))
        self.published.append((self._ms(), snapshot))
        self._on_commit(snapshot)
        return True
    =}

    // @override
    method _bind_inputs(){=
        bound = [
            name
            for name in self.fmu_inputs
            if self.data_model.get_node(f"Machine/inputs/{name}") is not None
        ]
        for name in bound:
            self._bind_input(f"Machine/inputs/{name}", name)
        self._log(
            "STARTUP",
            f"data model '{self.data_model.name}', FMU {self.path}; writes on "
            f"{bound} fire the trigger",
        )
    =}

    // @override
    method _on_input_write(fmu_input, previous, value){=
        self._log("WRITE", f"Machine/inputs/{fmu_input}: {previous} -> {value}")
        self.fmu_inputs[fmu_input] = value
        self.input_written = True
        self.writes.append((fmu_input, value))
        return True
    =}

    // @override
    method _external_trigger(tick){=
        if not self.input_written:
            return
        self.input_written = False
        self._log("TRIGGER", describe_trigger(lf.time.logical_elapsed(), self.fmu_ns, self.saved_ns))
        handled = self._set_trigger()
        if handled:
            self._set_inputs()
            self._commit()
            self._resume(tick)
        else:
            self._log("TRIGGER", "REFUSED: the change only enters the next simulated step")
        self.triggers += [(self._ms(), name, value, handled) for name, value in self.writes]
        self.writes = []
    =}
}
