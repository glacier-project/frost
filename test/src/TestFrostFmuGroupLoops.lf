target Python{
    fast: true,
    timeout: 16 s,
    files: [
        "../resources/lib/fmu_test_tools.py",
    ]
}
import FrostFmu from "../../src/lib/simulation/FrostFmu.lf"

preamble{=
    from frost import *
    from fmu_test_tools import compare

    # Every group here is two Gain FMUs (y = k * u + offset) in a loop through direct
    # feedthrough, a.y -> b.u listed first, so it is the tear. b.u settles at
    # a.offset / (1 - a.k * b.k).
    TEAR = [("a.y", "b.u")]

    # (ms, b.u): loop gain 0.5, a.offset 1 then 3 by a trigger at 250 ms.
    CONTRACTING_EXPECTED = [(0, 2.0), (100, 2.0), (200, 2.0), (250, 6.0), (300, 6.0), (400, 6.0), (500, 6.0)]
    # (ms, b.u): loop gain -1.5, relaxation 0.5: the iteration x -> -0.25 x + 0.5 settles at 0.4.
    RELAXED_EXPECTED = [(ms, 0.4) for ms in range(0, 501, 100)]
    # (ms, b.u, a.u, a.y) with the "delay" policy, a.y = 0.5 a.u + offset, b.y = b.u: b.u takes a.y
    # of the previous communication point, its start value 0 at the first, although startup
    # exchanges twice at 0 ms. The trigger at 750 ms writes a.offset = 2 and exchanges twice at
    # 750 ms (catch-up, then the write): b.u stays 1.5, the value of 500 ms.
    DELAYED_EXPECTED = [
        (0, 0.0, 0.0, 1.0), (500, 1.0, 1.0, 1.5), (750, 1.5, 1.5, 2.75),
        (1000, 2.75, 2.75, 3.375), (1500, 3.375, 3.375, 3.6875),
    ]
    # One step late, the loop still converges to the fixed point a.offset / (1 - 0.5).
    DELAYED_LIMIT = 4.0
=}

# Commits (ms, b.u) and checks the loop at every commit: the tear sits on the fixed point.
reactor LoopProbe(expected = {=[]=}) extends FrostFmu{
    state commits = {=[]=}

    method _commit(){=
        b_u, a_u = self.model.read("b.u"), self.model.read("a.u")
        assert abs(a_u - self.model.read("b.k") * b_u) < 1e-6, f"a.u = {a_u} must be b.y of b.u = {b_u}"
        self.commits.append((lf.time.logical_elapsed() // 1000000, round(b_u, 4)))
        return True
    =}

    reaction(startup){=
        assert self.model.policy == "fixed_point", "fixed_point must be the default policy"
        assert self.model.tears == TEAR, f"the connection listed first is the tear: {self.model.tears}"
        assert self.model.order == [("b.y", "a.u")], f"the rest of the loop: {self.model.order}"
    =}

    reaction(shutdown){=
        mismatches = compare(self.logger, f"{self.name}: commits (ms, b.u)", self.commits, self.expected)
        assert not mismatches, f"rows {mismatches} differ (see the table above)"
    =}
}

# Loop gain 0.5: the fixed-point iteration settles at every exchange, also after a trigger.
reactor ContractingLoop extends LoopProbe{
    timer change(250 ms)

    reaction(change) -> tick{=
        self.fmu_inputs["a.offset"] = 3.0
        assert self._set_trigger(), "the trigger must bring the loop to 250 ms"
        self._set_inputs()
        self._commit()
        self._resume(tick)
    =}
}

# Loop gain -1.5: it oscillates and diverges without relaxation, settles with 0.5.
reactor RelaxedLoop extends LoopProbe{
}

# Loop gain -1.5 without relaxation, a.offset 0: 0 is the fixed point and settles at once.
# a.offset = 1 at 250 ms, the last tag (stop_time), makes the exchange diverge: an error.
reactor DivergingLoop extends FrostFmu{
    timer change(250 ms)
    state raised = False

    reaction(change) -> tick{=
        assert self._set_trigger(), "the trigger must bring the loop to 250 ms"
        self.fmu_inputs["a.offset"] = 1.0
        try:
            self._set_inputs()
        except RuntimeError as error:
            assert "does not settle in 100 iterations" in str(error), f"unexpected error: {error}"
            self.raised = True
    =}

    reaction(shutdown){=
        assert self.raised, "a loop of gain -1.5 must not settle without relaxation"
    =}
}

# The "delay" policy: the tear takes the value of the previous communication point.
reactor DelayedLoop extends FrostFmu{
    timer change(750 ms)
    state commits = {=[]=}

    method _commit(){=
        row = tuple(self.model.read(name) for name in ("b.u", "a.u", "a.y"))
        self.commits.append((lf.time.logical_elapsed() // 1000000, *row))
        return True
    =}

    reaction(startup){=
        assert self.model.tears == TEAR, f"the connection listed first is the tear: {self.model.tears}"
    =}

    reaction(change) -> tick{=
        self.fmu_inputs["a.offset"] = 2.0
        assert self._set_trigger(), "the trigger must roll back to 500 ms and step to 750 ms"
        self._set_inputs()
        self._commit()
        self._resume(tick)
    =}

    reaction(shutdown){=
        head = self.commits[:len(DELAYED_EXPECTED)]
        mismatches = compare(self.logger, "delayed: first commits (ms, b.u, a.u, a.y)", head, DELAYED_EXPECTED)
        assert not mismatches, f"rows {mismatches} differ (see the table above)"
        ms, b_u = self.commits[-1][:2]
        self.logger.info(f"delayed: b.u = {b_u} at {ms} ms, fixed point {DELAYED_LIMIT}")
        assert ms == 15000 and abs(b_u - DELAYED_LIMIT) < 1e-6, f"b.u must converge to {DELAYED_LIMIT}: {b_u} at {ms} ms"
    =}
}

main reactor{
    contracting = new ContractingLoop(name="contracting",
        start_values = {= {"a.k": 0.5, "a.offset": 1.0} =}, expected = {= CONTRACTING_EXPECTED =})
    relaxed = new RelaxedLoop(name="relaxed", algebraic_relaxation = 0.5,
        start_values = {= {"a.k": -1.5, "a.offset": 1.0} =}, expected = {= RELAXED_EXPECTED =})
    diverging = new DivergingLoop(name="diverging", start_values = {= {"a.k": -1.5} =})
    delayed = new DelayedLoop(name="delayed", algebraic_loop_policy = "delay",
        start_values = {= {"a.k": 0.5, "a.offset": 1.0} =})
}
