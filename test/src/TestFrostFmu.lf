target Python{
    fast: true,
    timeout: 1 s,
    files: [
        "../resources/lib/fmu_test_tools.py",
        "../resources/lib/frost_fmu_expected.py",
    ]
}
import FrostFmu from "../../src/lib/simulation/FrostFmu.lf"

preamble{=
    from frost import *
    from fmu_test_tools import ns, log_line, compare, describe_trigger
    from frost_fmu_expected import *
=}

# Common part of every scenario: logs each event on one line and records each
# commit. At every commit the FMU must sit exactly on the LF tag; at shutdown
# the commits must equal `expected`.
reactor Probe(expected = {=[]=}, watched_output = "Float64_continuous_output") extends FrostFmu{
    state commits = {=[]=}

    method _ms(){=
        return lf.time.logical_elapsed() // 1000000
    =}

    method _log(kind, text){=
        self.logger.info(log_line(lf.time.logical_elapsed(), kind, text))
    =}

    method _watched(){=
        return self._get_outputs().get(self.watched_output)
    =}

    method _commit(){=
        now = lf.time.logical_elapsed()
        assert self.fmu_ns == now, f"commit with the FMU at {self.fmu_ns} ns but LF at {now} ns"

        value = self._watched()
        self._log("COMMIT", f"value = {value}")
        self.commits.append((self._ms(), value))
        return True
    =}

    method _write_input(name, value){=
        old = self.fmu_inputs.get(name)
        self.fmu_inputs[name] = value
        self._log("INPUT", f"{name}: {old} -> {value}")
    =}

    method _trigger(tick){=
        restart = self.saved_ns
        self._log("TRIGGER", describe_trigger(lf.time.logical_elapsed(), self.fmu_ns, restart))
        handled = self._set_trigger()
        if handled:
            self._set_inputs()
            self._commit()
            self._resume(tick)
        if not handled:
            self._log("TRIGGER", "REFUSED: the change only enters the next simulated step")
        return handled
    =}

    reaction(shutdown){=
        mismatches = compare(self.logger, f"{self.name}: commits (ms, {self.watched_output})", self.commits, self.expected)
        assert not mismatches, f"{self.name}: commit rows {mismatches} differ from the expected ones (see the table above)"
    =}
}

# Feedthrough (FMI 3.0, can roll back): one change inside a simulated step, one
# on a step tag, both triggered.
reactor RollbackFmu extends Probe{
    timer inside_a_step(250 ms)
    timer on_a_step_tag(500 ms)
    timer unknown_input(750 ms)

    reaction(startup){=
        assert self.can_rollback, f"{self.path} should declare canGetAndSetFMUstate"
    =}

    reaction(inside_a_step) -> tick{=
        # 250 ms lies inside the step 200 -> 300 ms, which the model has already simulated.
        assert self.fmu_ns == ns(300), f"before the change the model must be ahead at 300 ms, got {self.fmu_ns}"

        self._write_input(INPUT, 5.0)
        assert self._trigger(tick) is True, "a trigger inside a simulated step must be applied"
        # After the commit at 250 ms the model runs ahead again, with the new input.
        assert self.fmu_ns == ns(300), f"after the trigger the model must run ahead to 300 ms, got {self.fmu_ns}"

        # A second trigger rolls back the new run ahead, commits again and runs ahead again.
        assert self._trigger(tick) is True, "a second trigger at the same tag must be applied too"
        assert self.fmu_ns == ns(300), f"the model must run ahead to 300 ms again, got {self.fmu_ns}"
    =}

    reaction(on_a_step_tag) -> tick{=
        # The inherited tick already committed 500 ms and simulated ahead to 600 ms with the old input.
        assert self.fmu_ns == ns(600), f"before the change the model must be ahead at 600 ms, got {self.fmu_ns}"

        self._write_input(INPUT, 7.0)
        assert self._trigger(tick) is True, "a trigger on a step tag must be applied"
        assert self.fmu_ns == ns(600), f"after the trigger the model must run ahead to 600 ms, got {self.fmu_ns}"
    =}

    reaction(unknown_input){=
        self.fmu_inputs["not_an_input"] = 1.0
        try:
            self._set_inputs()
            raise AssertionError("an unknown input name must be rejected")
        except KeyError as error:
            self._log("INPUT", f"unknown input rejected as expected: {str(error).split(';')[0]}")
        finally:
            del self.fmu_inputs["not_an_input"]
    =}
}

# Feedthrough with a 1 s step: a trigger at 500 ms, in the middle of the doStep
# 0 -> 1000 ms already simulated.
reactor HalfStepFmu extends Probe{
    timer half_step(500 ms)

    reaction(half_step) -> tick{=
        assert self.fmu_ns == ns(1000), f"before the change the model must be ahead at 1000 ms, got {self.fmu_ns}"
        self._write_input(INPUT, 5.0)
        assert self._trigger(tick) is True, "a trigger in the middle of a doStep must be applied"
        assert self.fmu_ns == ns(1000), f"after the trigger the model must run ahead to 1000 ms, got {self.fmu_ns}"
    =}
}

# Same FMU and same changes as RollbackFmu, without triggers.
reactor LateFmu extends Probe{
    timer inside_a_step(250 ms)
    timer on_a_step_tag(500 ms)

    reaction(inside_a_step){=
        self._write_input(INPUT, 5.0)
        self._log("INPUT", "no trigger: the change enters the next step that gets simulated")
    =}

    reaction(on_a_step_tag){=
        self._write_input(INPUT, 7.0)
        self._log("INPUT", "no trigger: the change enters the next step that gets simulated")
    =}
}

# BouncingBall (FMI 2.0, cannot roll back, no outputs): never ahead of LF, so a
# trigger steps up to now.
reactor NoStateFmu extends Probe{
    timer inside_a_step(250 ms)

    reaction(startup){=
        assert not self.can_rollback, f"{self.path} should not declare canGetAndSetFMUstate"
        assert self.fmu_inputs == {} and self.fmu_outputs == [], f"unexpected interface {self.fmu_inputs} {self.fmu_outputs}"
    =}

    reaction(inside_a_step) -> tick{=
        # With a 70 ms step the last tag is 210 ms; without rollback the model is never past LF.
        assert self.fmu_ns == ns(210), f"at 250 ms the model must sit on its last tag, 210 ms, got {self.fmu_ns}"
        assert self._rollback() is False, "an FMU without saved state cannot roll back"

        assert self._trigger(tick) is True, "the trigger must step the model from 210 ms to 250 ms"
        assert self.fmu_ns == ns(250), "after the trigger the model must sit on 250 ms"
    =}
}

# EarlyReturnNoRollback (FMI 3.0, cannot roll back, early return every 250
# ms): early returns only split the steps, and a trigger steps up to now.
reactor NoRollbackEarlyFmu extends Probe{
    timer inside_a_step(600 ms)

    method _watched(){=
        return round(self._get_outputs()["value"], 9)
    =}

    reaction(startup){=
        assert not self.can_rollback, f"{self.path} should not declare canGetAndSetFMUstate"
    =}

    reaction(inside_a_step) -> tick{=
        assert self.fmu_ns == ns(500), f"without rollback the model must sit on 500 ms, got {self.fmu_ns}"
        self._write_input("rate", 2.0)
        assert self._trigger(tick) is True, "the trigger must step the model from 500 ms to 600 ms"
        assert self.fmu_ns == ns(600), f"after the trigger the model must sit on 600 ms, got {self.fmu_ns}"
    =}
}

# BouncingBall (FMI 3.0, can roll back, early return, Event Mode): each bounce
# becomes a tag, committed after the event is settled, so the ball already
# rises.
reactor EarlyReturnFmu extends Probe{
    method _watched(){=
        v = self._get_outputs()["v"]
        return "falling" if v < 0 else "rising" if v > 0 else "still"
    =}

    reaction(startup){=
        assert self.can_rollback, f"{self.path} should declare canGetAndSetFMUstate"
    =}
}

# Feedthrough starting at 1e9 model s (YAML start_time), triggered at 250 ms.
reactor BigStartFmu extends Probe{
    timer inside_a_step(250 ms)

    reaction(startup){=
        assert self.start_time == 1e9, f"start_time from YAML must be 1e9, got {self.start_time!r}"
    =}

    reaction(inside_a_step) -> tick{=
        self._write_input(INPUT, 5.0)
        assert self._trigger(tick) is True, "a trigger at a large start time must be applied"
        assert self.fmu_ns == ns(300), f"after the trigger the model must run ahead to 300 ms, got {self.fmu_ns}"
    =}
}

# TrafficController asked to terminate at 30 model s (300 ms).
reactor TerminateFmu extends Probe{
    reaction(shutdown){=
        assert not self.running, "the FMU must have requested termination"
        assert self.fmu_ns == ns(300), f"the FMU must stop where it terminated, 300 ms, got {self.fmu_ns}"
    =}
}

# TrafficController (FMI 3.0, can roll back, early return, Event Mode), started
# disabled and enabled by a trigger at 50 ms.
reactor TriggerEventFmu extends Probe{
    timer enable(50 ms)

    reaction(enable) -> tick{=
        assert self.fmu_ns == ns(200), f"disabled, the model must be ahead at 200 ms, got {self.fmu_ns}"
        self._write_input("enabled", True)
        assert self._trigger(tick) is True, "the trigger must enable the controller at 50 ms"
    =}
}

# TrafficController enabled from the start, disabled by a trigger at 10 ms,
# before the phase change at 20 ms it had already found.
reactor StaleTickFmu extends Probe{
    timer disable(10 ms)

    reaction(disable) -> tick{=
        assert self.fmu_ns == ns(20), f"the run ahead must stop at the phase change, 20 ms, got {self.fmu_ns}"
        self._write_input("enabled", False)
        assert self._trigger(tick) is True, "the trigger must disable the controller at 10 ms"
    =}
}

# Feedthrough with a start value, a YAML step written as 1e-1 and a YAML
# stop_time.
reactor StopFmu extends Probe{
    reaction(startup){=
        assert self.step_size == 0.1, f"step_size 1e-1 from YAML must become 0.1, got {self.step_size!r}"
        assert self.stop_time == 0.35, f"stop_time from YAML must be 0.35, got {self.stop_time!r}"
    =}

    reaction(shutdown){=
        assert self.fmu_ns == ns(300), f"no step may go past stop_time 350 ms, the model is at {self.fmu_ns}"
    =}
}

main reactor{
    rollback = new RollbackFmu(name="rollback", path="resources/fmu/Feedthrough.fmu", expected = {= ROLLBACK_EXPECTED =})
    half_step = new HalfStepFmu(name="half_step", path="resources/fmu/Feedthrough.fmu", expected = {= HALF_STEP_EXPECTED =})
    late = new LateFmu(name="late", path="resources/fmu/Feedthrough.fmu", expected = {= LATE_EXPECTED =})
    no_state = new NoStateFmu(name="no_state", path="resources/fmu/BouncingBall2.fmu", expected = {= NO_STATE_EXPECTED =})
    no_rollback_early = new NoRollbackEarlyFmu(name="no_rollback_early", path="resources/fmu/EarlyReturnNoRollback.fmu",
        watched_output = "value", expected = {= NO_ROLLBACK_EARLY_EXPECTED =})
    early_return = new EarlyReturnFmu(name="early_return", path="resources/fmu/BouncingBall3.fmu",
        watched_output = "v", expected = {= EARLY_RETURN_EXPECTED =})
    trigger_event = new TriggerEventFmu(name="trigger_event", path="resources/fmu/TrafficController.fmu",
        time_scale = 100.0, start_values = {= {"enabled": False} =},
        watched_output = "", expected = {= TRIGGER_EVENT_EXPECTED =})
    stale_tick = new StaleTickFmu(name="stale_tick", path="resources/fmu/TrafficController.fmu",
        time_scale = 100.0, watched_output = "", expected = {= STALE_TICK_EXPECTED =})
    big_start = new BigStartFmu(name="big_start", path="resources/fmu/Feedthrough.fmu", expected = {= BIG_START_EXPECTED =})
    terminate = new TerminateFmu(name="terminate", path="resources/fmu/TrafficController.fmu",
        time_scale = 100.0, start_values = {= {"terminate_after": 30.0} =},
        watched_output = "", expected = {= TERMINATE_EXPECTED =})
    stop = new StopFmu(name="stop", path="resources/fmu/Feedthrough.fmu",
        start_values = {= {"Float64_continuous_input": 1.5} =}, expected = {= STOP_EXPECTED =})
}
