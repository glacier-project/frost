target Python{
    files: [
        "../../python_lib/simulation/fmi/group.py",
    ],
}

import FrostFmuBase from "FrostFmuBase.lf"

preamble{=
from group import FmuGroup
import numpy as np
=}

reactor FrostFmu(
    algebraic_loop_policy = "fixed_point",
    algebraic_abs_tolerance = {=1e-9=},
    algebraic_rel_tolerance = {=1e-6=},
    algebraic_relaxation = 1.0,
    max_algebraic_iterations = 100
) extends FrostFmuBase{
    '''One FMU, or several coupled FMUs, synchronized by LF logical time.

    The YAML config of the reactor gives the FMUs. path for one FMU: its
    variables keep their names. fmus and connections for several: they step
    together in Python on one model time and exchange their connections at
    every communication point (see FmuGroup); variables are named
    "<member>.<variable>" and fmu_inputs holds the inputs no connection drives.
    Either way LF sees one model; see FrostFmuBase for the tags, the run ahead
    and how to change an input at the current tag.

    The FMUs that can roll back run ahead: an early return of one of them
    becomes the next tag, and a trigger rolls them back. The others step only
    when LF reaches the tag; an early return of theirs just splits their
    step. start_time, step_size and tolerance default to the DefaultExperiment
    (several FMUs: the earliest start, the smallest step).

    Args:
        algebraic_loop_policy (str):
            "fixed_point" iterates each algebraic loop at the same instant;
            "delay" cuts it with a one-step delay. See FmuGroup.
        algebraic_abs_tolerance, algebraic_rel_tolerance (float):
            Convergence of the fixed-point iteration.
        algebraic_relaxation (float):
            In (0, 1]; below 1 damps loops that oscillate.
        max_algebraic_iterations (int):
            Iterations per exchange before an error.

    Attributes:
        path (str | None):
            From the YAML config, for one FMU: FMU archive path.
        fmus (dict[str, str] | None):
            From the YAML config, for several FMUs: member name -> FMU archive
            path; names hold no ".".
        connections (list[list[str]] | None):
            From the YAML config: [output, input] pairs of dotted names.
        fmu_dictionary (dict[str, ModelVariable]):
            Variable name -> fmpy ModelVariable (type, valueReference, shape,
            causality); no Clocks.

    '''

    state path
    state fmus
    state connections
    state fmu_dictionary
    state written_inputs

    // @override
    method _build_model(){=
        '''Open, initialize and couple the FMUs.

        Returns:
            FmuGroup:
                Every FMU in Step Mode, any initial event already settled.

        '''
        if bool(self.path) == bool(self.fmus):
            raise ValueError(
                f"{self.name}: set path (one FMU) or fmus (several) in the "
                "YAML config"
            )
        for name in ("step_size", "start_time", "stop_time", "tolerance"):
            if getattr(self, name) is not None:
                setattr(self, name, float(getattr(self, name)))
        group = FmuGroup(
            self.fmus or {self.name: self.path},
            self.connections or [],
            self.start_values,
            self.tolerance,
            self.start_time,
            self.stop_time,
            self.logger,
            dotted=bool(self.fmus),
            policy=self.algebraic_loop_policy,
            abs_tolerance=float(self.algebraic_abs_tolerance),
            rel_tolerance=float(self.algebraic_rel_tolerance),
            relaxation=float(self.algebraic_relaxation),
            max_iterations=int(self.max_algebraic_iterations),
        )
        self.start_time, self.tolerance = group.start_time, group.tolerance
        if self.step_size is None:
            self.step_size = group.step_size
        self.fmu_dictionary = {
            name: variable for name, (_, variable) in group.variables.items()
        }
        self.fmu_inputs = dict.fromkeys(group.inputs)
        self.written_inputs = {}
        self.fmu_outputs = group.outputs
        self.can_rollback = bool(group.ahead)
        self.fmu_ns = 0
        return group
    =}

    // @override
    method _shutdown(){=
        '''Terminate and free every member.'''
        if self.model is None:
            return
        self.logger.info(f"Shutting down {self.name}")
        try:
            self.model.close()
        finally:
            self.model = None
    =}

    // @override
    method _set_inputs(){=
        '''Write the values of fmu_inputs that changed, then exchange.

        A value equal to the last one written is skipped, and without any
        write so is the exchange: the members already hold the exchanged
        values of this instant.
        '''
        written = False
        for name, value in self.fmu_inputs.items():
            if value is None or (
                name in self.written_inputs
                and np.array_equal(self.written_inputs[name], value)
            ):
                continue
            self.model.write(name, value)
            self.written_inputs[name] = value
            written = True
        if written:
            self.model.exchange()
    =}

    // @override
    method _get_outputs(){=
        '''Read every member output.

        Returns:
            dict[str, Any]:
                Output values keyed by dotted name.

        '''
        return {name: self.model.read(name) for name in self.fmu_outputs}
    =}

    // @override
    method _do_step(next_target){=
        '''Step the members that can roll back towards the target.

        Args:
            next_target (int):
                Logical elapsed time in ns the group must reach.

        Returns:
            bool:
                True while every such member can continue.

        '''
        to = self.start_time + next_target / 1e9 * self.time_scale
        self.saved_ns, self.saved_inputs = self.fmu_ns, dict(self.fmu_inputs)
        running = self.model.step(to)
        self.fmu_ns = (
            next_target
            if self.model.time == to
            else round(
                (self.model.time - self.start_time) / self.time_scale * 1e9
            )
        )
        return running
    =}

    // @override
    method _rollback(){=
        '''Restore the members that can roll back to before the last step.

        Returns:
            bool:
                True once restored; False when no state was saved.

        '''
        if not self.model.rollback():
            return False
        self.fmu_ns = self.saved_ns
        self.fmu_inputs = dict(self.saved_inputs)
        return True
    =}
}
