target Python{
    files: [        
        "../../python_lib/time_utils.py",
        "../../python_lib/simulation/sim_time.py",
        "../../python_lib/simulation/participant.py",
        "../../python_lib/simulation/simulation_message.py",
        "../../python_lib/simulation/simulation_message_handler.py",
        "../../python_lib/simulation/operation.py",
    ],
}

import FrostBase from "../FrostBase.lf"

preamble{=
from simulation_message_handler import SimulationMessageHandler
=}

reactor CoSimProtocolBase extends FrostBase{
    '''
    Base of the reactors that speak the co-simulation protocol; owns the message dispatcher.

    Extension:
        Children register the operations they answer with
        self.simulation_handler.register_handler(operation, handler).
    '''

    state simulation_handler = {=SimulationMessageHandler(self.name)=}
}
