target Python{
    files: [
        "../../python_lib/time_utils.py",
    ],
}

import FrostBase from "../FrostBase.lf"

reactor FrostHostBase extends FrostBase{
    '''Own the model of a reactor: build it at startup and shut it down.

    Extension:
        _build_model():
            Required; return the model object this reactor drives.
        _shutdown():
            Required; close the model. Call it from the last shutdown
            reaction of the leaf reactor.
        _set_inputs(), _get_outputs(), _do_step(next_target):
            Required; the I/O and stepping of the model.

    Attributes:
        model (Any):
            The model built by _build_model(); None before startup.

    '''

    state model

    method _build_model(){=
        '''Build the model this reactor drives.

        Returns:
            Any:
                The model object.

        '''
        raise NotImplementedError(
            f"{self.name}: extend a model reactor such as FrostFmuBase, "
            "or override _build_model()"
        )
    =}

    method _shutdown(){=
        '''Close the model and release every resource it holds.'''
        raise NotImplementedError(
            f"{self.name}: extend a model reactor such as FrostFmuBase, "
            "or override _shutdown()"
        )
    =}

    method _set_inputs(){=
        '''Write the current input state of the model; call before _do_step.'''
        raise NotImplementedError(
            f"{self.name}: extend a model reactor such as FrostFmuBase, "
            "or override _set_inputs()"
        )
    =}

    method _get_outputs(){=
        '''Read every output of the model.

        Returns:
            dict:
                Output values keyed by name.

        '''
        raise NotImplementedError(
            f"{self.name}: extend a model reactor such as FrostFmuBase, "
            "or override _get_outputs()"
        )
    =}

    method _do_step(next_target){=
        '''Advance the model to the target tag.

        Args:
            next_target (int):
                Logical elapsed time in ns the model must reach.

        Returns:
            bool:
                True while the model can continue.

        '''
        raise NotImplementedError(
            f"{self.name}: extend a model reactor such as FrostFmuBase, "
            "or override _do_step()"
        )
    =}

    method _rollback(){=
        '''Roll back the model to the state before the last _do_step.

        Returns:
            bool:
                True once restored.

        '''
        raise NotImplementedError(
            f"{self.name}: extend a model reactor such as FrostFmuBase, "
            "or override _rollback()"
        )
    =}

    method _commit(){=
        '''Commit the outputs outside, or to the machine data model, if any.

        Called after the model has advanced to the current tag and published
        its outputs.

        Mandatory: LF has to reach the logical tag at which the model has
        advanced.

        Notice: if your reactor also extends FrostReactor, you can commit the
        outputs to the machine data model, if any.

        Returns:
            bool:
                True once committed.

        '''
        return False
    =}

    method _set_trigger(){=
        '''Bring the model to the current tag after a trigger arrived.

        The reactor shall roll back to the previous step and advance to the
        current tag.

        Notice: in co-simulation you must commit the event to the
        orchestrator, if any, so that it can propagate the event to the other
        models.

        Returns:
            bool:
                True once the model sits on the current tag, otherwise False.

        '''
        return False
    =}

    // @label _build_model
    reaction(startup){=
        '''Build the model.'''
        try:
            self.model = self._build_model()
        except Exception as error:
            self.logger.error(f"{self.name} cannot build its model: {error}")
            raise
    =}
}
