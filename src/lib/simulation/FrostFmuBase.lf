target Python{
    files: [
        "../../python_lib/simulation/fmi/fmi2.py",
        "../../python_lib/simulation/fmi/fmi3.py",
        "../../python_lib/simulation/fmi/loader.py",
    ],
}

import FrostHostBase from "FrostHostBase.lf"

preamble{=
from fmpy.fmi1 import FMICallException
from fmpy.fmi2 import fmi2Discard
from fmpy.model_description import DefaultExperiment
from loader import BUILD_LOCK, close_fmu, initialize, open_fmu
=}

reactor FrostFmuBase(
    path = "",
    start_values = {={}=},
    time_scale = 1.0
) extends FrostHostBase{
    '''Implement the FrostHostBase hooks with fmpy, for FMI 2.0 and 3.0.

    Only the Co-Simulation interface is used.

    Args:
        path (str):
            FMU archive path.
        start_values (dict):
            Values written in Initialization Mode, keyed by variable name.
        time_scale (float):
            Model seconds per logical second.

    Attributes:
        step_size, start_time, tolerance (float | None):
            Read from the archive at build unless set in YAML.
        stop_time (float | None):
            YAML only; LF decides when to stop.
        fmu_time (float):
            Model time the FMU sits on.
        fmu_ns (int):
            Logical tag, in ns, the FMU sits on. Exact after a full step;
            rounded to the ns from fmu_time only after an early return.
        fmu_dictionary (dict[str, ModelVariable]):
            Variable name -> fmpy ModelVariable (type, valueReference, shape,
            causality); no Clocks.
        fmu_inputs (dict[str, Any]):
            Input name -> value; None keeps the value of the FMU.
        fmu_outputs (list[str]):
            Output names.

    '''

    state step_size
    state start_time
    state stop_time
    state tolerance

    state fmu_time
    state fmu_ns
    state fmu_dictionary
    state fmu_inputs
    state fmu_outputs
    state can_rollback
    state saved_state
    state saved_time
    state saved_ns
    state saved_inputs

    // @override
    method _build_model(){=
        '''Extract the archive, instantiate and initialize the FMU.

        The FMU ends in Step Mode, with any initial event already settled.

        Returns:
            FMU2Frost | FMU3Frost:
                The initialized FMU.

        '''
        for name in ("step_size", "start_time", "stop_time", "tolerance"):
            if getattr(self, name) is not None:
                setattr(self, name, float(getattr(self, name)))
        with BUILD_LOCK:
            fmu, description = open_fmu(self.path, self.name)
            try:
                experiment = (
                    description.defaultExperiment or DefaultExperiment()
                )
                if self.start_time is None:
                    self.start_time = float(experiment.startTime or 0)
                if self.step_size is None and experiment.stepSize:
                    self.step_size = float(experiment.stepSize)
                if self.tolerance is None and experiment.tolerance:
                    self.tolerance = float(experiment.tolerance)

                initialize(
                    fmu,
                    description,
                    self.start_values,
                    self.tolerance,
                    self.start_time,
                    self.stop_time,
                )

                self.fmu_dictionary = {
                    v.name: v
                    for v in description.modelVariables
                    if v.type != "Clock"
                }
                self.fmu_inputs = {
                    name: None
                    for name, v in self.fmu_dictionary.items()
                    if v.causality == "input"
                }
                self.fmu_outputs = [
                    name
                    for name, v in self.fmu_dictionary.items()
                    if v.causality == "output"
                ]
                self.can_rollback = (
                    description.coSimulation.canGetAndSetFMUstate
                )
                self.fmu_time = self.start_time
                self.fmu_ns = 0
                return fmu
            except Exception:
                close_fmu(fmu, terminate=False)
                raise
    =}

    // @override
    method _shutdown(){=
        '''Terminate and free the FMU, then remove the extracted archive.'''
        if self.model is None:
            return
        self.logger.info(f"Shutting down {self.name}")
        try:
            close_fmu(self.model, terminate=True)
        finally:
            self.model = None
    =}

    // @override
    method _set_inputs(){=
        '''Write every assigned value of fmu_inputs into the FMU.'''
        for name, value in self.fmu_inputs.items():
            if value is not None:
                self.model.write(self.fmu_dictionary[name], value)
    =}

    // @override
    method _get_outputs(){=
        '''Read every FMU output; arrays come back in their declared shape.

        Returns:
            dict[str, Any]:
                Output values keyed by name.

        '''
        return {
            name: self.model.read(self.fmu_dictionary[name])
            for name in self.fmu_outputs
        }
    =}

    // @override
    method _do_step(next_target){=
        '''Advance the FMU to the logical time target.

        On an early return the FMU stops before next_target, at an internal
        event; fmu_ns tells where. With Event Mode the event is already
        settled, so _get_outputs shows the state after it.

        Args:
            next_target (int):
                Logical elapsed time in ns the FMU must reach.

        Returns:
            bool:
                True while the FMU can continue; False once it terminated or
                discarded the step.

        '''
        to = self.start_time + next_target / 1e9 * self.time_scale
        if self.model.terminated:
            return False
        if self.can_rollback:
            if self.saved_state is not None:
                self.model.freeFMUState(self.saved_state)
            self.saved_state = self.model.getFMUState()
            self.saved_time = self.fmu_time
            self.saved_ns = self.fmu_ns
            self.saved_inputs = dict(self.fmu_inputs)
        try:
            terminate, early_time = self.model.step(
                self.fmu_time,
                to - self.fmu_time,
                self.can_rollback,
            )
        except FMICallException as error:
            if error.status != fmi2Discard:
                raise
            self.logger.error(
                f"{self.name} discarded the step from {self.fmu_time} to {to}"
            )
            return False
        self.logger.debug(
            f"{self.name} stepped from {self.fmu_time} to "
            f"{to if early_time is None else early_time} (target {to}) at "
            f"{lf.time.logical_elapsed()} ns"
        )
        if early_time is None:
            self.fmu_time, self.fmu_ns = to, next_target
        else:
            self.fmu_time = early_time
            self.fmu_ns = round(
                (early_time - self.start_time) / self.time_scale * 1e9
            )
        if terminate:
            self.logger.debug(
                f"{self.name} requested termination at {self.fmu_time}"
            )
            return False
        return True
    =}

    // @override
    method _rollback(){=
        '''Restore the FMU to the state saved before the last _do_step.

        Returns:
            bool:
                True once restored; False when no state was saved.

        '''
        if self.saved_state is None:
            return False
        self.model.setFMUState(self.saved_state)
        self.fmu_time = self.saved_time
        self.fmu_ns = self.saved_ns
        self.fmu_inputs = dict(self.saved_inputs)
        return True
    =}
}
