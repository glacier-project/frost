target Python{
    files: [
        "../../python_lib/simulation/fmi/fmi2.py",
        "../../python_lib/simulation/fmi/fmi3.py",
    ],
}

import FrostHostBase from "FrostHostBase.lf"

preamble{=
import shutil
import threading
import fmpy
from fmpy.fmi1 import FMICallException
from fmpy.fmi2 import fmi2Discard
from fmpy.model_description import DefaultExperiment
from fmpy.simulation import apply_start_values, settable_in_initialization_mode
from fmi2 import FMU2Frost
from fmi3 import FMU3Frost

# LF may build several FMUs in parallel at startup: libxml2 schema parsing is not thread-safe,
# and fmpy changes the process-wide working directory while it loads a library.
BUILD_LOCK = threading.Lock()
=}

reactor FrostFmuBase(
    path = "",
    start_values = {={}=},
    time_scale = 1.0
) extends FrostHostBase{
    '''
    FMU model type: implements the FrostHostBase hooks with fmpy, for FMI 2.0 and 3.0 Co-Simulation.

    Args:
        path (str): FMU archive path.
        start_values (dict): Values written in Initialization Mode, keyed by variable name.
        time_scale (float): Model seconds per logical second.

    Attributes:
        step_size, start_time, tolerance: Read from the archive at build unless set in YAML.
        stop_time: YAML only; LF decides when to stop.
        fmu_dictionary (dict): Variable name -> fmpy ModelVariable (type, valueReference, shape, causality); no Clocks.
        fmu_inputs (dict): Input name -> value; None keeps the FMU's own value.
        fmu_outputs (list): Output names.
    '''

    state step_size
    state start_time
    state stop_time
    state tolerance

    state fmu_time
    state fmu_dictionary
    state fmu_inputs
    state fmu_outputs
    state can_rollback
    state saved_state
    state saved_time
    state saved_inputs

    // @override
    method _build_model(){=
        '''
        Extract the archive, instantiate the FMU and initialize it into Step Mode.

        Returns:
            FMU2Frost | FMU3Frost: The initialized FMU.
        '''
        with BUILD_LOCK:
            unzipdir = fmpy.extract(self.path)
            fmu = None
            try:
                description = fmpy.read_model_description(unzipdir)
                if description.coSimulation is None:
                    raise ValueError(f"{self.path} has no Co-Simulation interface")
                fmu_class = {"2.0": FMU2Frost, "3.0": FMU3Frost}.get(description.fmiVersion)
                if fmu_class is None:
                    raise ValueError(f"{self.path} declares unsupported fmiVersion {description.fmiVersion!r}")
                fmu = fmu_class(unzipdir, description, self.name)

                experiment = description.defaultExperiment or DefaultExperiment()
                if self.start_time is None: self.start_time = float(experiment.startTime or 0)
                if self.step_size is None and experiment.stepSize: self.step_size = float(experiment.stepSize)
                if self.tolerance is None and experiment.tolerance: self.tolerance = float(experiment.tolerance)

                fmu.enter_initialization(self.tolerance, self.start_time, self.stop_time)
                if rejected := apply_start_values(fmu, description, self.start_values, settable_in_initialization_mode):
                    raise KeyError(f"{self.name} cannot set {sorted(rejected)} in Initialization Mode")
                fmu.exitInitializationMode()

                self.fmu_dictionary = {v.name: v for v in description.modelVariables if v.type != "Clock"}
                self.fmu_inputs = {name: None for name, v in self.fmu_dictionary.items() if v.causality == "input"}
                self.fmu_outputs = [name for name, v in self.fmu_dictionary.items() if v.causality == "output"]
                self.can_rollback = description.coSimulation.canGetAndSetFMUstate
                self.fmu_time = self.start_time
                return fmu
            except Exception:
                if fmu is not None:
                    fmu.freeInstance()
                shutil.rmtree(unzipdir, ignore_errors=True)
                raise
    =}

    // @override
    method _shutdown(){=
        '''Terminate and free the FMU, then remove the extracted archive.'''
        if self.model is None:
            return
        self.logger.info(f"Shutting down {self.name}")
        try:
            self.model.terminate()
        finally:
            self.model.freeInstance()
            shutil.rmtree(self.model.unzipDirectory, ignore_errors=True)
            self.model = None
    =}

    // @override
    method _set_inputs(){=
        '''Write every assigned value of fmu_inputs into the FMU.'''
        for name, value in self.fmu_inputs.items():
            if value is not None:
                self.model.write(self.fmu_dictionary[name], value)
    =}

    // @override
    method _get_outputs(){=
        '''
        Read every FMU output; arrays come back in their declared shape.

        Returns:
            dict: Output values keyed by name.
        '''
        return {name: self.model.read(self.fmu_dictionary[name]) for name in self.fmu_outputs}
    =}

    // @override
    method _do_step(next_target){=
        '''
        Advance the FMU to the logical time target.

        Args:
            next_target (int): Logical elapsed time in ns the FMU must reach.

        Returns:
            bool: True while the FMU can continue; False once it terminated or discarded the step.
        '''
        to = self.start_time + next_target / 1e9 * self.time_scale
        if self.can_rollback:
            if self.saved_state is not None:
                self.model.freeFMUState(self.saved_state)
            self.saved_state, self.saved_time, self.saved_inputs = self.model.getFMUState(), self.fmu_time, dict(self.fmu_inputs)
        try:
            terminate = self.model.step(self.fmu_time, to - self.fmu_time, self.can_rollback)
        except FMICallException as error:
            if error.status != fmi2Discard:
                raise
            self.logger.error(f"{self.name} discarded the step from {self.fmu_time} to {to}")
            return False
        self.fmu_time = to
        if terminate:
            self.logger.info(f"{self.name} requested termination at {to}")
            return False
        return True
    =}

    // @override
    method _rollback(){=
        '''
        Restore the FMU to the state saved before the last _do_step.

        Returns:
            bool: True once restored; False when no state was saved.
        '''
        if self.saved_state is None:
            return False
        self.model.setFMUState(self.saved_state)
        self.fmu_time = self.saved_time
        self.fmu_inputs = dict(self.saved_inputs)
        return True
    =}
}
